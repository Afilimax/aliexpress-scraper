{
  "name": "@afilimax/aliexpress-scraper",
  "version": "0.1.0",
  "type": "commonjs",
  "description": "Scraper resiliente de produtos do AliExpress focado no Brasil (BRL) para o ecossistema Afilimax.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Afilimax/aliexpress-scraper.git"
  },
  "homepage": "https://github.com/Afilimax/aliexpress-scraper#readme",
  "bugs": {
    "url": "https://github.com/Afilimax/aliexpress-scraper/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*",
    "!/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx ./src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "afilimax",
    "aliexpress",
    "scraper",
    "crawler",
    "ecommerce",
    "produtos",
    "afiliados"
  ],
  "author": "Marcuth",
  "license": "MIT",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "impit": "^0.14.6",
    "puppeteer-core": "^25.14.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "peerDependencies": {
    "@afilimax/core": "^0.5.0"
  }
}
